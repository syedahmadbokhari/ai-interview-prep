# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Groq API key for answer generation (free at console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_64_hex_chars

# Single API user. Hash a password with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
API_USERNAME=your_username
API_PASSWORD_HASH=$2b$12$replace_with_bcrypt_hash

# Optional overrides (defaults shown)
# JWT_EXPIRY_MINUTES=45
# RATE_LIMIT=10/minute
